<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity_Login">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout_editor_absoluteX="-146dp"
        tools:layout_editor_absoluteY="0dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="400dp">

            <TextView
                android:id="@+id/textView_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Login"
                android:textSize="55sp"
                android:gravity="center"
                android:layout_marginTop="40sp"
                android:fontFamily="@font/mtd_cheese_sauce_font"/>

            <TextView
                android:id="@+id/textView_email_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="25dp"
                android:fontFamily="@font/mtd_cheese_sauce_font"
                android:text="Email"
                android:textSize="23sp"/>

            <EditText
                android:id="@+id/edit_email_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:layout_marginStart="25dp"
                android:layout_marginEnd="25dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/mtd_cheese_sauce_font"
                android:hint="Enter your email"
                android:inputType="textEmailAddress"
                android:background="@drawable/custom_edittext_border"/>

            <TextView
                android:id="@+id/textView_pass_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="25dp"
                android:fontFamily="@font/mtd_cheese_sauce_font"
                android:text="Password"
                android:textSize="23sp" />

            <EditText
                android:id="@+id/edit_password_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:layout_marginStart="25dp"
                android:layout_marginEnd="25dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/mtd_cheese_sauce_font"
                android:background="@drawable/custom_edittext_border"
                android:inputType="textPassword"
                android:hint="Enter your password"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginEnd="25dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView_fgpass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="25dp"
                    android:fontFamily="@font/mtd_cheese_sauce_font"
                    android:text="Forgot password?"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/textView_register_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="end"
                    android:layout_weight="1"
                    android:fontFamily="@font/mtd_cheese_sauce_font"
                    android:text="Register"
                    android:textSize="25sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_signin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in"
                android:layout_marginTop="40dp"
                android:layout_gravity="center"
                android:fontFamily="@font/mtd_cheese_sauce_font"
                android:textSize="30sp"
                android:textColor="@color/black"
                app:backgroundTint="@null"
                android:background="@drawable/btn_custom"/>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>